{
  "version": 1,
  "packages": [
    {
      "name": "relaybar",
      "path": ".",
      "checks": [
        {
          "name": "lockfile",
          "role": "lockfiles",
          "command": [
            "swift",
            "package",
            "resolve",
            "--only-use-versions-from-resolved-file"
          ]
        },
        {
          "name": "vulnerabilities",
          "role": "vulnerabilities",
          "parallel": true,
          "command": [
            "osv-scanner",
            "scan",
            "source",
            "--all-packages",
            "--lockfile=Package.resolved",
            "--format=json",
            "--output-file=coverage/osv.json"
          ],
          "report": {
            "type": "osv",
            "path": "coverage/osv.json"
          }
        },
        {
          "name": "format",
          "role": "format",
          "parallel": true,
          "command": [
            "swift",
            "format",
            "lint",
            "--strict",
            "--recursive",
            "Package.swift",
            "Sources",
            "Tests"
          ]
        },
        {
          "name": "tests",
          "role": "swift-tests",
          "command": [
            "scripts/test.sh"
          ]
        },
        {
          "name": "build",
          "role": "build",
          "command": [
            "./build.sh"
          ]
        },
        {
          "name": "efficiency",
          "role": "efficiency",
          "command": [
            "scripts/efficiency.sh"
          ]
        }
      ]
    }
  ],
  "shared": [
    {
      "name": "secrets-files",
      "role": "secrets-files",
      "parallel": true,
      "command": [
        "gitleaks",
        "dir",
        ".",
        "--redact=100",
        "--no-banner",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-files.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-files.sarif"
      }
    },
    {
      "name": "secrets-history",
      "role": "secrets-history",
      "parallel": true,
      "command": [
        "gitleaks",
        "git",
        ".",
        "--redact=100",
        "--no-banner",
        "--log-opts=--all",
        "--report-format",
        "sarif",
        "--report-path",
        "coverage/gitleaks-history.sarif"
      ],
      "report": {
        "type": "gitleaks",
        "path": "coverage/gitleaks-history.sarif"
      }
    },
    {
      "name": "security",
      "role": "security",
      "parallel": true,
      "command": [
        "semgrep",
        "scan",
        "--config",
        "p/default",
        "--exclude=.agents",
        "--exclude=.hooks",
        "--jobs",
        "2",
        "--error",
        "--strict",
        "--time",
        "--json",
        "--output",
        "coverage/semgrep.json",
        "."
      ],
      "report": {
        "type": "semgrep",
        "path": "coverage/semgrep.json"
      }
    },
    {
      "name": "shellcheck",
      "role": "shell",
      "parallel": true,
      "command": [
        "shellcheck",
        "--",
        "build.sh",
        "scripts/test.sh",
        "scripts/efficiency.sh"
      ]
    }
  ],
  "shipping": {
    "base": "main",
    "checks": [
      "hard-eng"
    ],
    "ui_paths": [
      "Sources/Relaybar/*",
      "Resources/*",
      "Info.plist"
    ],
    "ci_seconds": 900,
    "pre_push_seconds": 600,
    "delivery": []
  }
}
